# Ollama configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=gemma4:e2b
EMBED_MODEL=embeddinggemma-2:270m

# 4GB VRAM-friendly inference defaults
OLLAMA_NUM_CTX=4096
OLLAMA_THINK=false
OLLAMA_TEMPERATURE=0.2

# Local Chroma DB configuration (no Docker)
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8000
CHROMA_COLLECTION=grand_aurora_hotel_rules

# Express API server port
SERVER_PORT=3001
